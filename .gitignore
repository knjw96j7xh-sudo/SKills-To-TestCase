# 构建产物（自动生成）
dist/

# 项目资产（用户本地数据，不纳入版本控制）
# 保留 _template 模板，忽略其他项目
projects/*
!projects/_template/

# 历史记录目录（保留目录结构，不追踪用例文件）
.testcase-assets/history/*
!.testcase-assets/history/.gitkeep

# 本机环境配置（含用户名路径，不同机器不同）
.claude/settings.local.json

# macOS 系统文件
.DS_Store
**/.DS_Store

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 临时导出文件（放在项目根目录时）
/testcases_*.xlsx
/testcases_*.xmind
/export_data_*.json

# 本地编辑器
.vscode/
