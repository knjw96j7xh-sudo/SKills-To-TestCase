{
  "_comment": "用例表列配置文件，定义用例表的列结构、顺序和格式",
  "_usage": "skill 文件读取此配置生成用例表，用户可自定义列",
  "columns": [
    {
      "field": "id",
      "header": "用例ID",
      "required": true,
      "editable": false,
      "description": "用例编号，格式 TC-XXX",
      "width": "auto"
    },
    {
      "field": "test_point",
      "header": "测试点",
      "required": true,
      "editable": true,
      "description": "测试点描述",
      "width": "auto"
    },
    {
      "field": "precondition",
      "header": "前置条件",
      "required": true,
      "editable": true,
      "description": "环境/数据要求",
      "width": "auto"
    },
    {
      "field": "steps",
      "header": "操作步骤",
      "required": true,
      "editable": true,
      "description": "步骤列表，换行分隔",
      "width": "auto"
    },
    {
      "field": "expected",
      "header": "预期结果",
      "required": true,
      "editable": true,
      "description": "可验证的预期结果",
      "width": "auto"
    },
    {
      "field": "checkpoint",
      "header": "关联检查点",
      "required": true,
      "editable": true,
      "description": "检查点编号，如 UC-01",
      "width": "auto"
    },
    {
      "field": "type",
      "header": "场景类型",
      "required": true,
      "editable": false,
      "description": "正向/异常/边界/并发",
      "width": "auto",
      "enum": [
        "正向",
        "异常",
        "边界",
        "并发"
      ]
    },
    {
      "field": "priority",
      "header": "优先级",
      "required": true,
      "editable": false,
      "description": "P0/P1/P2/P3",
      "width": "auto",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    {
      "field": "module",
      "header": "所属模块",
      "required": true,
      "editable": true,
      "description": "功能模块细分，多模块时自动填写",
      "width": "auto"
    }
  ],
  "optional_columns": [
    {
      "field": "review_point",
      "header": "关联评审点",
      "required": false,
      "editable": true,
      "description": "评审点编号，如 UX-01",
      "width": "auto"
    },
    {
      "field": "executor",
      "header": "执行人",
      "required": false,
      "editable": true,
      "description": "用例执行负责人",
      "width": "auto"
    },
    {
      "field": "status",
      "header": "执行状态",
      "required": false,
      "editable": true,
      "description": "未执行/通过/失败/阻塞",
      "width": "auto",
      "enum": [
        "未执行",
        "通过",
        "失败",
        "阻塞"
      ]
    },
    {
      "field": "remark",
      "header": "备注",
      "required": false,
      "editable": true,
      "description": "补充说明",
      "width": "auto"
    },
    {
      "field": "automation",
      "header": "自动化标记",
      "required": false,
      "editable": true,
      "description": "是否适合自动化：是/否/待评估",
      "width": "auto",
      "enum": [
        "是",
        "否",
        "待评估"
      ]
    }
  ],
  "settings": {
    "id_prefix": "TC",
    "id_digits": 3,
    "default_priority_rule": "P0=异常场景，P1=正向主流程/边界，P2=并发/低频边界，P3=体验类",
    "scene_types": [
      "正向",
      "异常",
      "边界",
      "并发"
    ],
    "priority_levels": [
      "P0",
      "P1",
      "P2",
      "P3"
    ],
    "priority_colors": {
      "P0": "red",
      "P1": "orange",
      "P2": "blue",
      "P3": "gray"
    }
  },
  "metadata_section": {
    "enabled": true,
    "fields": [
      {
        "field": "project",
        "label": "项目名称"
      },
      {
        "field": "module",
        "label": "测试对象"
      },
      {
        "field": "source",
        "label": "需求来源"
      },
      {
        "field": "date",
        "label": "生成日期"
      },
      {
        "field": "checkpoints",
        "label": "关联检查点"
      },
      {
        "field": "review_points",
        "label": "关联评审点"
      }
    ]
  },
  "statistics_section": {
    "enabled": true,
    "group_by": "type",
    "show_percentage": true
  },
  "review_section": {
    "enabled": true,
    "columns": [
      "评审轮次",
      "日期",
      "评审点",
      "覆盖状态",
      "处理结果"
    ]
  }
}